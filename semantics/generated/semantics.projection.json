      "requires": "a REAL producer -> actual boundary -> actual consumer conformance fixture passes for the mechanism, not a test-only crossing"
    },
    {
      "id": "AP5",
      "requires": "a reachable watched-red exists and was driven red before it was driven green"
    },
    {
      "id": "AP6",
