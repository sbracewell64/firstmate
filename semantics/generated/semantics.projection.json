    },
    {
      "name": "REFUSED",
      "terminal": true,
      "obligation_required": false,
      "consumer_action": "route the owed ruling to its authority; do not retry, and do not read the refusal as a failure of the work",
      "legal_successors": [
        "SUPERSEDED"
      ]
    },
    {
      "name": "CANCELLED",
      "terminal": true,
      "obligation_required": false,
      "consumer_action": "record and stop; nothing failed and nothing is owed",
      "legal_successors": [
