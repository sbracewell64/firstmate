  "protocol_law": [
    {
      "rule_id": "P1",
      "rule": "A version string is not a format. A reader validates the SHAPE and reports SCHEMA_SHAPE_MISMATCH, kept distinct from SCHEMA_UNSUPPORTED_VERSION."
    },
    {
      "rule_id": "P2",
      "rule": "Both sides declare the versions they accept. An unknown, absent or unnegotiated version REFUSES; it is never parsed on a guess and never defaulted."
    },
    {
      "rule_id": "P3",
      "rule": "A shared record namespace declares its producers. A record from an undeclared producer is SCHEMA_UNDECLARED_PRODUCER: quarantined and PRESERVED, never deleted."
    }
  ]
