{
  "schema": "review-envelope-array-classifications/v1",
  "classifications": [
    {"path": "candidate.changed_files", "order": "canonicalized", "reason": "Rows are emitted in unique path order.", "experiment": {"kind": "exempt", "condition": "fewer-than-two-distinct-elements"}},
    {"path": "capabilities", "order": "canonicalized", "reason": "Capabilities are sorted by stable capability id.", "experiment": {"kind": "input-recompile", "input_path": "capabilities"}},
    {"path": "capabilities[].candidates", "order": "order-meaningful", "reason": "The first candidate that resolves and states its identity is selected.", "experiment": {"kind": "input-recompile", "input_path": "capabilities[].candidates"}},
    {"path": "capabilities[].identity_argv", "order": "order-meaningful", "reason": "Argument order is part of the invoked identity command.", "experiment": {"kind": "input-recompile", "input_path": "capabilities[].identity_argv"}},
    {"path": "capabilities[].probes", "order": "order-meaningful", "reason": "Probe order records candidate evaluation in declaration order.", "experiment": {"kind": "body-recompute"}},
    {"path": "capabilities[].selected.identity_argv", "order": "order-meaningful", "reason": "Argument order records the identity command that selected the candidate.", "experiment": {"kind": "body-recompute"}},
    {"path": "ci.attempts", "order": "canonicalized", "reason": "Attempts are restricted to documented fields and sorted by stable attempt identity.", "experiment": {"kind": "input-recompile", "input_path": "ci.attempts"}},
    {"path": "ci.checks", "order": "canonicalized", "reason": "Checks are emitted from sorted workflow and check-name groups.", "experiment": {"kind": "input-recompile", "input_path": "ci.attempts"}},
    {"path": "ci.checks[].platforms", "order": "canonicalized", "reason": "Platforms are sorted as the set covered by the current attempt.", "experiment": {"kind": "exempt", "condition": "fewer-than-two-distinct-elements"}},
    {"path": "ci.head_unknown_attempts", "order": "canonicalized", "reason": "Summaries are sorted by stable summary identity.", "experiment": {"kind": "input-recompile", "input_path": "ci.attempts"}},
    {"path": "ci.required_platforms", "order": "canonicalized", "reason": "Required platforms are sorted as a set.", "experiment": {"kind": "input-recompile", "input_path": "ci.required_platforms"}},
    {"path": "ci.wrong_head_attempts", "order": "canonicalized", "reason": "Summaries are sorted by stable summary identity.", "experiment": {"kind": "exempt", "condition": "fewer-than-two-distinct-elements"}},
    {"path": "findings.adverse", "order": "canonicalized", "reason": "Findings are sorted by stable finding id.", "experiment": {"kind": "input-recompile", "input_path": "findings.adverse"}},
    {"path": "findings.unproven", "order": "canonicalized", "reason": "Dimensions are sorted by stable dimension id.", "experiment": {"kind": "input-recompile", "input_path": "findings.unproven"}},
    {"path": "identity.project.root_commits", "order": "canonicalized", "reason": "Root commits are sorted by commit id.", "experiment": {"kind": "exempt", "condition": "fewer-than-two-distinct-elements"}},
    {"path": "obligations.active", "order": "canonicalized", "reason": "Active obligations are sorted by stable obligation id.", "experiment": {"kind": "input-recompile", "input_path": "obligations.active"}},
    {"path": "obligations.dispositions", "order": "canonicalized", "reason": "Dispositions are sorted by stable obligation id.", "experiment": {"kind": "input-recompile", "input_path": "obligations.dispositions"}},
    {"path": "obligations.predecessor_active", "order": "canonicalized", "reason": "Predecessor obligations are sorted by stable obligation id.", "experiment": {"kind": "exempt", "condition": "fewer-than-two-distinct-elements"}},
    {"path": "rulings", "order": "canonicalized", "reason": "Rulings are sorted by stable ruling id.", "experiment": {"kind": "input-recompile", "input_path": "rulings"}},
    {"path": "rulings[].mismatches", "order": "canonicalized", "reason": "Mismatch axes are appended in the fixed work_id, head, tree and envelope_digest order.", "experiment": {"kind": "exempt", "condition": "fewer-than-two-distinct-elements"}},
    {"path": "scope.excluded", "order": "order-meaningful", "reason": "Scope classification is first-match-wins and credits the first matching rule.", "experiment": {"kind": "input-recompile", "input_path": "scope.excluded"}},
    {"path": "scope.excluded_paths", "order": "canonicalized", "reason": "Excluded paths are sorted by unique path.", "experiment": {"kind": "exempt", "condition": "fewer-than-two-distinct-elements"}},
    {"path": "scope.in_scope_paths", "order": "canonicalized", "reason": "In-scope paths are sorted as a set.", "experiment": {"kind": "exempt", "condition": "fewer-than-two-distinct-elements"}},
    {"path": "scope.unused_exclusions", "order": "canonicalized", "reason": "Unused exclusions are sorted by stable rule id.", "experiment": {"kind": "exempt", "condition": "fewer-than-two-distinct-elements"}},
    {"path": "verification.applicability_rules", "order": "canonicalized", "reason": "Applicability rules are sorted by contract id and complete record.", "experiment": {"kind": "input-recompile", "input_path": "verification.applicability_rules"}},
    {"path": "verification.applicability_rules[].paths", "order": "canonicalized", "reason": "Path rules are sorted because matching uses set-like any semantics.", "experiment": {"kind": "input-recompile", "input_path": "verification.applicability_rules[].paths"}},
    {"path": "verification.contracts", "order": "canonicalized", "reason": "Contracts are sorted by stable contract identity.", "experiment": {"kind": "input-recompile", "input_path": "verification.contracts"}},
    {"path": "verification.contracts[].execution_worlds", "order": "canonicalized", "reason": "Execution worlds are sorted as the set requiring results.", "experiment": {"kind": "input-recompile", "input_path": "verification.contracts[].execution_worlds"}},
    {"path": "verification.required_contract_ids", "order": "canonicalized", "reason": "Required contract ids are sorted as a set.", "experiment": {"kind": "exempt", "condition": "fewer-than-two-distinct-elements"}},
    {"path": "verification.results", "order": "canonicalized", "reason": "Results are sorted by stable result identity.", "experiment": {"kind": "input-recompile", "input_path": "verification.results"}}
  ]
}
